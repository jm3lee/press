{
  "name": "flashoffer-react",
  "version": "0.1.0",
  "description": "Flashoffer UI components and theme primitives for React applications.",
  "keywords": [
    "flashoffer",
    "mui",
    "react",
    "design-system"
  ],
  "license": "MIT",
  "main": "dist/flashoffer-react.cjs.js",
  "module": "dist/flashoffer-react.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/flashoffer-react.es.js",
      "require": "./dist/flashoffer-react.cjs.js",
      "default": "./dist/flashoffer-react.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "vite build",
    "docs": "typedoc",
    "lint": "eslint --ext .ts,.tsx src",
    "lint:ci": "eslint --ext .ts,.tsx src --rule \"complexity: ['error', { 'max': 10 }]\" --quiet",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@mui/utils": "^7.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "jest-environment-jsdom": "^29.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
